{
  "name": "pagewise",
  "version": "1.0.0",
  "description": "PageWise - Client-side RAG system for browser extension - Chat with any page",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "npx http-server . -p 8080 -o test/local-test.html",
    "screenshot": "node scripts/screenshot.js"
  },
  "keywords": [
    "rag",
    "browser-extension",
    "semantic-search",
    "vector-search"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@orama/orama": "^1.0.0",
    "@xenova/transformers": "^2.17.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.254",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.1.6",
    "copy-webpack-plugin": "^11.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "puppeteer": "^25.0.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.6",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
